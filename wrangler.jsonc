{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-24",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "pzmodmanager",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"workers_dev": false,
	"preview_urls": false
}