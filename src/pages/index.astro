---
import Layout from '../layouts/Layout.astro';
---

<Layout title="PZ Mod Extractor">
	<div id="app"></div>
</Layout>

<style is:global>
	body {
		margin: 0;
		background: #10161d;
		color: #c6d4df;
		font-family:
			-apple-system,
			BlinkMacSystemFont,
			'Segoe UI',
			Roboto,
			sans-serif;
	}

	@keyframes pz-spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	a {
		color: #66c0f4;
		text-decoration: none;
	}

	a:hover {
		color: #7ed0ff;
		text-decoration: underline;
	}

	.mx-scroll {
		scrollbar-width: thin;
		scrollbar-color: #316282 #0e141b;
	}

	.mx-scroll::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}

	.mx-scroll::-webkit-scrollbar-track {
		background: #0e141b;
		border-radius: 8px;
	}

	.mx-scroll::-webkit-scrollbar-thumb {
		background: #316282;
		border-radius: 8px;
		border: 2px solid #0e141b;
	}

	.mx-scroll::-webkit-scrollbar-thumb:hover {
		background: #66c0f4;
	}
</style>

<script>
	import { mount } from '../scripts/modExtractor';

	const root = document.getElementById('app');
	if (root) mount(root);
</script>
