---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="PZ Mod Extractor"
	description="Paste a Steam Workshop collection link and get a ready-to-use Project Zomboid mod list."
>
	<div id="app"></div>
</Layout>

<script>
	import { mount } from '../scripts/modExtractor';

	const root = document.getElementById('app');
	if (root) mount(root);
</script>
