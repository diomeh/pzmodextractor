---
import Layout from '../layouts/Layout.astro';
---

<Layout title="PZ Mod Extractor">
	<div id="app"></div>
</Layout>

<style is:global>
	body {
		margin: 0;
		background: #000000;
		color: #e8e8e8;
		font-family:
			-apple-system,
			BlinkMacSystemFont,
			'Segoe UI',
			Roboto,
			sans-serif;
	}

	@keyframes pz-spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	a {
		color: #45b545;
		text-decoration: none;
	}

	a:hover {
		color: #6ec96e;
		text-decoration: underline;
	}

	.mx-scroll {
		scrollbar-width: thin;
		scrollbar-color: #555555 #000000;
	}

	.mx-scroll::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}

	.mx-scroll::-webkit-scrollbar-track {
		background: #000000;
		border-radius: 0;
	}

	.mx-scroll::-webkit-scrollbar-thumb {
		background: #555555;
		border-radius: 0;
		border: 2px solid #000000;
	}

	.mx-scroll::-webkit-scrollbar-thumb:hover {
		background: #45b545;
	}
</style>

<script>
	import { mount } from '../scripts/modExtractor';

	const root = document.getElementById('app');
	if (root) mount(root);
</script>
